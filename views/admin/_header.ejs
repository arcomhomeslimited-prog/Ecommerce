<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> · <%= settings.store_name %> Admin</title>
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin">
<%
  const navItems = [
    ['/', 'Dashboard', 'M3 12 12 4l9 8M5 10v10h14V10'],
    ['/orders', 'Orders', 'M6 6h15l-1.5 9h-12L6 6Zm0 0L5 3H2M9 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2Zm9 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z', badges.orders],
    ['/products', 'Products', 'M21 8 12 3 3 8v8l9 5 9-5V8ZM3 8l9 5 9-5M12 13v8'],
    ['/categories', 'Categories', 'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z'],
    ['/customers', 'Customers', 'M16 19v-1a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v1M9 10a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm13 9v-1a4 4 0 0 0-3-3.9M16 4.1a3 3 0 0 1 0 5.8'],
    ['/discounts', 'Discount codes', 'M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8ZM7.5 7.5h.01'],
    ['/reviews', 'Reviews', 'm12 3 2.7 5.6 6.3.9-4.5 4.4 1 6.1L12 17l-5.5 3 1-6.1L3 9.5l6.3-.9L12 3Z', badges.reviews],
    ['/messages', 'Messages', 'M4 5h16v12H8l-4 3V5Z', badges.messages],
    ['/subscribers', 'Subscribers', 'M4 6h16v12H4zM4 7l8 6 8-6'],
    ['/settings', 'Settings', 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z'],
    ['/account', 'Account & team', 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-8 9a8 8 0 0 1 16 0']
  ];
  const isActive = href => href === '/' ? adminPath === '/' : adminPath.startsWith(href);
%>
<div class="shell">
  <aside class="sidebar" data-sidebar>
    <a href="/admin" class="brand">
      <span class="brand-mark">A</span>
      <span><strong>ArcomHomes</strong><small>Store admin</small></span>
    </a>
    <nav>
      <% navItems.forEach(([href, label, icon, badge]) => { %>
        <a href="/admin<%= href === '/' ? '' : href %>" class="<%= isActive(href) ? 'active' : '' %>">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="<%= icon %>"/></svg>
          <span><%= label %></span>
          <% if (badge) { %><b class="nav-badge"><%= badge %></b><% } %>
        </a>
      <% }) %>
    </nav>
    <div class="sidebar-foot">
      <a href="/" target="_blank" rel="noopener">View store ↗</a>
      <form action="/admin/logout" method="post"><button>Sign out</button></form>
    </div>
  </aside>
  <div class="sidebar-scrim" data-sidebar-close></div>

  <div class="content">
    <header class="topbar">
      <button class="icon-btn menu-btn" data-sidebar-open aria-label="Open menu"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button>
      <form action="/admin/products" method="get" class="top-search">
        <input type="search" name="q" placeholder="Search products…" aria-label="Search products">
      </form>
      <div class="top-user"><span class="avatar"><%= (user.first_name || user.email)[0].toUpperCase() %></span><span class="top-email"><%= user.email %></span></div>
    </header>
    <main class="page">
      <% if (flash) { %><div class="flash flash-<%= flash.type %>" role="status"><%= flash.message %></div><% } %>
