<table class="spec-table">
  <tr><th>Standard UK mainland</th><td><%= money(settings.shipping_flat_rate) %> · 2–4 working days</td></tr>
  <tr><th>Orders over <%= money(settings.free_shipping_threshold) %></th><td>Free</td></tr>
  <tr><th>Large items (baths, vanity units)</th><td>Two-person delivery to your room of choice, 3–7 working days</td></tr>
  <tr><th>Highlands, Islands &amp; Northern Ireland</th><td>Please <a href="/contact">contact us</a> for a quote</td></tr>
