</main>

<section class="usp-strip" aria-label="Why shop with us">
  <div class="wrap usp-grid">
    <div><strong>Free UK delivery</strong><span>On orders over <%= money(settings.free_shipping_threshold) %></span></div>
    <div><strong>30-day returns</strong><span>Unused items, no quibbles</span></div>
    <div><strong>Long guarantees</strong><span>Up to lifetime on ceramics</span></div>
    <div><strong>Secure checkout</strong><span>Prices include VAT</span></div>
  </div>
</section>

<section class="newsletter" id="newsletter">
  <div class="wrap newsletter-inner">
    <div>
      <h2>Join the ArcomHomes list</h2>
      <p>New collections, styling ideas and 10% off your first order.</p>
    </div>
    <form action="/subscribe" method="post" class="newsletter-form">
      <label class="sr-only" for="nl-email">Email address</label>
      <input id="nl-email" type="email" name="email" placeholder="Your email address" required>
      <button class="btn">Subscribe</button>
    </form>
  </div>
</section>

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <a href="/" class="logo logo-light">
        <span class="logo-text">ARCOM<span>HOMES</span></span>
      </a>
      <p><%= settings.store_tagline %>, delivered across the UK.</p>
      <p class="footer-contact">
        <a href="mailto:<%= settings.store_email %>"><%= settings.store_email %></a><br>
        <a href="tel:<%= settings.store_phone.replace(/\s/g, '') %>"><%= settings.store_phone %></a>
      </p>
    </div>
    <div>
      <h3>Bathroom</h3>
      <ul><% nav.bathroom.forEach(c => { %><li><a href="/c/<%= c.slug %>"><%= c.name %></a></li><% }) %></ul>
    </div>
    <div>
      <h3>Kitchen</h3>
      <ul>
        <% nav.kitchen.forEach(c => { %><li><a href="/c/<%= c.slug %>"><%= c.name %></a></li><% }) %>
        <li><a href="/new">New in</a></li>
        <li><a href="/sale">Sale</a></li>
      </ul>
    </div>
    <div>
      <h3>Help</h3>
      <ul>
        <li><a href="/contact">Contact us</a></li>
        <li><a href="/delivery">Delivery</a></li>
        <li><a href="/returns">Returns &amp; refunds</a></li>
        <li><a href="/faq">FAQs</a></li>
        <li><a href="/account">My account</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <p>&copy; <%= new Date().getFullYear() %> <%= settings.store_address %><%= settings.company_number ? ' · Company no. ' + settings.company_number : '' %><%= settings.vat_number ? ' · VAT no. ' + settings.vat_number : '' %></p>
    <p><a href="/terms">Terms</a> · <a href="/privacy">Privacy</a> · <a href="/about">About</a></p>
  </div>
</footer>

<script src="/js/main.js" defer></script>
</body>
</html>
